function addChildrenFromHit(parentX: number, parentZ: number, parentStep: number, output: ScanCell[]): void {
    const half = parentStep / 4;
    const childStep = parentStep / 2;
    const yawRad = ScanYawDeg * Math.PI / 180.0;
    const ux = Math.cos(yawRad);
    const uz = Math.sin(yawRad);
    const vx = -Math.sin(yawRad);
    const vz = Math.cos(yawRad);

    function pushChild(sx: number, sz: number): void {
        output.push({
            x: parentX + (ux * sx + vx * sz),
            z: parentZ + (uz * sx + vz * sz),
            step: childStep
        });
    }

    pushChild(-half, -half);
    pushChild(half, -half);
    pushChild(-half, half);
    pushChild(half, half);
}

function getQuadProbePoint(node: QuadNode): { x: number; z: number } {
    const [ox, oz] = QUAD_PROBE_OFFSETS[node.probeIndex];
    const probeRadius = node.halfSize * QUAD_PROBE_COVERAGE;
    const yawRad = ScanYawDeg * Math.PI / 180.0;
    const ux = Math.cos(yawRad);
    const uz = Math.sin(yawRad);
    const vx = -Math.sin(yawRad);
    const vz = Math.cos(yawRad);
    const localX = ox * probeRadius;
    const localZ = oz * probeRadius;
    return {
        x: node.x + (ux * localX + vx * localZ),
        z: node.z + (uz * localX + vz * localZ)
    };
}

function getQuadProbeLimit(node: QuadNode): number {
    if (node.halfSize <= (INITIAL_PROBE_CELL_SIZE * 0.5)) return 1;
    return QUAD_PROBE_OFFSETS.length;
}

function fireQuadProbe(bot: mod.Player, botIndex: number, node: QuadNode): void {
    const probe = getQuadProbePoint(node);
    fireRay(bot, botIndex, probe.x, probe.z, Phase.QuadTreeSearch, node.halfSize * 2);
}

function pushAdaptiveChildren(parentX: number, parentZ: number, parentStep: number): void {
    addChildrenFromHit(parentX, parentZ, parentStep, scanStack);
}

function clamp(value: number, minValue: number, maxValue: number): number {
    return Math.max(minValue, Math.min(maxValue, value));
}

export function OnGameModeStarted(): void {
    beginScan = true;
    mod.PauseGameModeTime(false);  // Ensure game is unpaused so bots can deploy
    CheckAndLogCurrentMap();
    console.log("Spawning bots...");
    void run();
}

async function buildQuadGrid(): Promise<void> {
    const halfCell = INITIAL_PROBE_CELL_SIZE * 0.5;
    const minCenterX = -MapHalfSizeX + halfCell;
    const maxCenterX = MapHalfSizeX - halfCell;
    const minCenterZ = -MapHalfSizeZ + halfCell;
    const maxCenterZ = MapHalfSizeZ - halfCell;
    const yawRad = ScanYawDeg * Math.PI / 180.0;
    const cosYaw = Math.cos(yawRad);
    const sinYaw = Math.sin(yawRad);

    for (let lx = minCenterX; lx <= maxCenterX; lx += INITIAL_PROBE_CELL_SIZE) {
        for (let lz = minCenterZ; lz <= maxCenterZ; lz += INITIAL_PROBE_CELL_SIZE) {
            const wx = MapCenterX + (lx * cosYaw - lz * sinYaw);
            const wz = MapCenterZ + (lx * sinYaw + lz * cosYaw);
            quadQueue.push({ x: wx, z: wz, halfSize: halfCell, probeIndex: 0 });
        }
    }

    // Initialise per-bot pending arrays
    pendingQuadNodes = new Array<QuadNode | null>(bots.length).fill(null);
    pendingScanCells = new Array<ScanCell | null>(bots.length).fill(null);

    console.log(`Quad seeds: ${quadQueue.length} (${INITIAL_PROBE_CELL_SIZE}x${INITIAL_PROBE_CELL_SIZE})`);
    console.log(`Bots available: ${aliveBotCount()} — starting QuadTree scan...`);
    scanStarted = true;
}

async function run(): Promise<void> {
    await spawnBots();
    // Now pause game time so the scan processes one ray per tick
    // without the game world advancing under us.
    mod.PauseGameModeTime(true);
    await buildQuadGrid();
}

function fireRay(bot: mod.Player, botIndex: number, x: number, z: number, phase: Phase, step: number): void {
    const seq = raySequence++;
    let jitterBase = 50;
    let tiltBase = 100;

    if (phase === Phase.QuadTreeSearch) {
        tiltBase = 0;
        jitterBase = step * 0.25;
    }

    if (phase === Phase.AdaptiveScan) {
        jitterBase = Math.max(JITTER_MIN, Math.min(JITTER_MAX, step * 0.35));
        tiltBase = Math.max(4, Math.min(100, step * 0.5));
    }

    const estimatedTerrainY = terrainYSampleCount > 0 ? avgTerrainY : (ytop + ybot) * 0.5;
    const ySpan = ybot - ytop;
    const t = ySpan !== 0 ? Math.max(0, Math.min(1, (estimatedTerrainY - ytop) / ySpan)) : 0.5;
    const expectedScale = (2 * t) - 1;
    const hitFactor = Math.abs(expectedScale);
    const segmentHalf = Math.max(step * 0.5, 1);
    const desiredHalfSpread = Math.max(JITTER_MIN * 0.5, step * COVERAGE_RATIO);

    let tilt = tiltBase;
    if (phase === Phase.AdaptiveScan && hitFactor > 0) {
        const maxTiltFromSegment = segmentHalf / hitFactor;
        tilt = Math.min(tiltBase, maxTiltFromSegment);
    }

    const jitterFromCoverage = 2 * Math.max(0, desiredHalfSpread - (hitFactor * tilt));
    const jitterFromSegment = 2 * Math.max(0, segmentHalf - (hitFactor * tilt));
    const jitter = Math.max(0, Math.min(jitterBase, jitterFromCoverage, jitterFromSegment));

    const yawRad = ScanYawDeg * Math.PI / 180.0;
    const ux = Math.cos(yawRad);
    const uz = Math.sin(yawRad);
    const vx = -Math.sin(yawRad);
    const vz = Math.cos(yawRad);

    const r0 = hash01(x, z, step, seq + (phase * 11.0));
    const r1 = hash01(z, x, step * 0.73, seq * 0.37 + (phase * 7.0));
    const r2 = hash01(x + z, step, seq * 0.11, phase * 13.0);
    const diskRadius = Math.sqrt(r0) * (jitter * 0.5);
    const diskAngle = (r1 * Math.PI * 2.0) + (seq * 2.399963229728653); // golden-angle decorrelation
    const jLocalX = Math.cos(diskAngle) * diskRadius;
    const jLocalZ = Math.sin(diskAngle) * diskRadius;
    const jx = x + (ux * jLocalX + vx * jLocalZ);
    const jz = z + (uz * jLocalX + vz * jLocalZ);

    const effectiveTiltDeg = phase === Phase.QuadTreeSearch ? 0 : ScanTiltDeg;
    const absYSpan = Math.abs(ybot - ytop);
    const desiredOffsetMag = Math.tan(Math.abs(effectiveTiltDeg) * Math.PI / 180.0) * absYSpan;

    let dirLocalX = 0;
    let dirLocalZ = 0;
    if (desiredOffsetMag > 1e-6) {
        const signX = effectiveTiltDeg >= 0 ? 1 : -1;
        const preferredAngle = signX > 0 ? 0 : Math.PI;
        const spread = Math.PI * 0.55;
        const tiltAngle = preferredAngle + ((r2 - 0.5) * spread);
        // Bias toward local X while still allowing angled variation.
        dirLocalX = Math.cos(tiltAngle) * 1.2;
        dirLocalZ = Math.sin(tiltAngle) * 0.85;
        const dLen = Math.sqrt((dirLocalX * dirLocalX) + (dirLocalZ * dirLocalZ));
        if (dLen > 1e-6) {
            dirLocalX /= dLen;
            dirLocalZ /= dLen;
        }
    }

    const dLocalX = dirLocalX * desiredOffsetMag;
    const dLocalZ = dirLocalZ * desiredOffsetMag;
    const dWorldX = ux * dLocalX + vx * dLocalZ;
    const dWorldZ = uz * dLocalX + vz * dLocalZ;

    // Anchor to in-cell jitter point and solve endpoints so the ray crosses that point
    // at the expected terrain height ratio t.
    const sx = jx - (t * dWorldX);
    const sz = jz - (t * dWorldZ);
    const ex = jx + ((1 - t) * dWorldX);
    const ez = jz + ((1 - t) * dWorldZ);

    const p = new RayParams(sx, ytop, sz, ex, ybot, ez, phase, botIndex);
    queue.push(p);
    mod.RayCast(bot, v(p.sx, p.sy, p.sz), v(p.ex, p.ey, p.ez));
}

function startAdaptiveScan(): void {
    phase = Phase.AdaptiveScan;
    console.log(`Scan Phase: Adaptive (${scanStack.length} seed cells found via QuadTree)`);
}

function tickBot(bot: mod.Player, botIndex: number): void {
    switch (phase) {
        case Phase.QuadTreeSearch: {
            const pending = pendingQuadNodes[botIndex];
            if (pending) {
                // Retry the existing pending node (re-fires its probe)
                fireQuadProbe(bot, botIndex, pending);
            } else if (quadQueue.length > 0) {
                const node = quadQueue.pop()!;
                pendingQuadNodes[botIndex] = node;
                fireQuadProbe(bot, botIndex, node);
            }
            break;
        }

        case Phase.AdaptiveScan: {
            const pending = pendingScanCells[botIndex];
            if (pending) {
                // This shouldn't happen (cleared on hit/miss), but guard anyway
                return;
            }
            if (scanStack.length > 0) {
                const cell = scanStack.pop()!;
                pendingScanCells[botIndex] = cell;
                fireRay(bot, botIndex, cell.x, cell.z, Phase.AdaptiveScan, cell.step);
            }
            break;
        }
    }
}

export function OngoingGlobal(): void {
    if (!beginScan || done) return;
    if (!scanStarted) return;

    // If all bots are idle and all work pools are empty, advance phases or finish
    if (quadQueue.length === 0 && scanStack.length === 0) {
        // Check if any bot still has pending work
        let anyPending = false;
        for (let i = 0; i < bots.length; i++) {
            if (pendingQuadNodes[i] || pendingScanCells[i]) { anyPending = true; break; }
        }
        if (!anyPending) {
            if (phase === Phase.QuadTreeSearch) {
                startAdaptiveScan();
            } else {
                done = true;
                mod.AddUIText("Complete", v(0,0,0), v(200,100,100), mod.UIAnchor.Center, mod.Message("Complete!"));
                console.log("MAPPING COMPLETE");
                mod.EndGameMode(mod.GetTeam(0));
                return;
            }
        }
    }

    // Fire one work item per alive bot
    for (let i = 0; i < bots.length; i++) {
        if (!isAlive(bots[i])) continue;

        // If this bot already has a pending quad node and it hasn't exhausted probes, retry it
        // Otherwise, pull new work
        tickBot(bots[i], i);
    }
}

// ── Bot deployment handler ─────────────────────────────────

export function OnPlayerDeployed(p: mod.Player) {
    if (mod.GetSoldierState(p, mod.SoldierStateBool.IsAISoldier)) {
        const id = mod.GetObjId(p);
        if (!seenIds.has(id)) {
            seenIds.add(id);
            bots.push(p);
            console.log(`Bot deployed: ${bots.length}/${BOT_COUNT}`);
        }
        mod.SetPlayerMaxHealth(p, 500);
        mod.Heal(p, 500);
        mod.AIIdleBehavior(p);
    }
}

// ── Raycast result handlers ────────────────────────────────

export function OnRayCastHit(eventPlayer: mod.Player, eventPoint: mod.Vector, eventNormal: mod.Vector): void {
    // Find the RayParams for this bot's in-flight ray by scanning the queue
    // (In practice the queue order matches the fire order, so the first entry
    //  for this bot is the one we want.)
    const bi = botIndexByPlayer(eventPlayer);
    if (bi < 0) return;

    let p: RayParams | null = null;
    for (let i = 0; i < queue.length; i++) {
        if (queue[i].botIndex === bi) {
            p = queue.splice(i, 1)[0];
            break;
        }
    }
    if (!p) return;

    const px = mod.XComponentOf(eventPoint);
    const py = mod.YComponentOf(eventPoint);
    const pz = mod.ZComponentOf(eventPoint);
    const nx = mod.XComponentOf(eventNormal);
    const ny = mod.YComponentOf(eventNormal);
    const nz = mod.ZComponentOf(eventNormal);

    if (terrainYSampleCount === 0) avgTerrainY = py;
    else avgTerrainY += (py - avgTerrainY) * TERRAIN_Y_EMA_ALPHA;
    terrainYSampleCount++;

    console.log(`HIT|P:${px},${py},${pz}|N:${nx},${ny},${nz}`);

    if (p.phase === Phase.QuadTreeSearch) {
        const node = pendingQuadNodes[bi];
        if (node) {
            if (node.halfSize <= QUAD_MIN_SIZE) {
                scanStack.push({ x: node.x, z: node.z, step: node.halfSize * 2 });
            } else {
                const size = node.halfSize;
                const quarter = size / 2;
                const yawRad = ScanYawDeg * Math.PI / 180.0;
                const ux = Math.cos(yawRad);
                const uz = Math.sin(yawRad);
                const vx = -Math.sin(yawRad);
                const vz = Math.cos(yawRad);
                function pushNode(sx: number, sz: number): void {
                    quadQueue.push({
                        x: node!.x + (ux * sx + vx * sz),
                        z: node!.z + (uz * sx + vz * sz),
                        halfSize: quarter,
                        probeIndex: 0
                    });
                }
                pushNode(-quarter, -quarter);
                pushNode(quarter, -quarter);
                pushNode(-quarter, quarter);
                pushNode(quarter, quarter);
            }
            pendingQuadNodes[bi] = null;
        }
    } else if (p.phase === Phase.AdaptiveScan) {
        const cell = pendingScanCells[bi];
        if (cell && cell.step > TARGET_STEP) {
            pushAdaptiveChildren(cell.x, cell.z, cell.step);
        }
        pendingScanCells[bi] = null;
    }
}

export function OnRayCastMissed(eventPlayer: mod.Player): void {
    const bi = botIndexByPlayer(eventPlayer);
    if (bi < 0) return;

    let p: RayParams | null = null;
    for (let i = 0; i < queue.length; i++) {
        if (queue[i].botIndex === bi) {
            p = queue.splice(i, 1)[0];
            break;
        }
    }
    if (!p) return;

    console.log(`MISS|S:${p.sx},${p.sy},${p.sz}|E:${p.ex},${p.ey},${p.ez}`);

    if (p.phase === Phase.QuadTreeSearch) {
        const node = pendingQuadNodes[bi];
        if (node) {
            node.probeIndex++;
            if (node.probeIndex >= getQuadProbeLimit(node)) {
                pendingQuadNodes[bi] = null;
            }
        }
    } else if (p.phase === Phase.AdaptiveScan) {
        pendingScanCells[bi] = null;
    }
}
